# Independent, cookieless Vercel pageview baseline. Enable only in Production.
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false

# Optional Google Analytics remains OFF for the Vercel-baseline rollout.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel sets VERCEL_ENV automatically. Only for a production self-hosted build:
# ANALYTICS_DEPLOYMENT_ENV=production

# Contact form (server-only). Never use NEXT_PUBLIC_ for these values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL_TO=
