# Analytics is OFF until both values are deliberately configured and rebuilt.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel sets VERCEL_ENV automatically. Only for a production self-hosted build:
# ANALYTICS_DEPLOYMENT_ENV=production

# Contact form (server-only). Never use NEXT_PUBLIC_ for these values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL_TO=
